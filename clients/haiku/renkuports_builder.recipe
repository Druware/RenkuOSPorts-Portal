SUMMARY="Build client for the RenkuOSPorts package coordinator"
DESCRIPTION="RenkuPorts Builder claims build jobs from a RenkuOSPorts coordinator, \
builds each recipe with HaikuPorter in a local ports tree, and uploads the \
resulting packages (or reports the failure with the build log). A small window \
holds the settings and shows the current build, its output and recent results."
HOMEPAGE="https://github.com/Druware/RenkuOSPorts-Portal"
COPYRIGHT="2026 Druware"
LICENSE="MIT"
REVISION="1"
# Draft: set the commit (or a release tag) and its checksum before adding this to RenkuOSPorts.
srcGitRev="COMMIT"
SOURCE_URI="https://github.com/Druware/RenkuOSPorts-Portal/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="CHECKSUM"
SOURCE_DIR="RenkuOSPorts-Portal-$srcGitRev/clients/haiku"

ARCHITECTURES="all"

PROVIDES="
	renkuports_builder = $portVersion
	app:RenkuPortsBuilder = $portVersion
	"
REQUIRES="
	haiku
	cmd:git
	cmd:haikuporter
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:gcc
	cmd:make
	"

BUILD()
{
	make OBJ_DIR=objects $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp objects/RenkuPortsBuilder $appsDir/
	addAppDeskbarSymlink $appsDir/RenkuPortsBuilder "RenkuPorts Builder"
}
